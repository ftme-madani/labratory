# ===================================================================
# تنظیمات محیطی سامانه آزمایشگاه مجازی علوم (Virtual Science Laboratory)
# ===================================================================

PROJECT_NAME="سامانه آزمایشگاه مجازی هوشمند علوم تجربی"
SECRET_KEY="replace_with_a_long_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# پایگاه داده: برای محیط توسعه SQLite و برای سرور ابری PostgreSQL
DATABASE_URL="sqlite:///./virtual_lab.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/virtual_lab_db"

# ===================================================================
# تنظیمات دستیار هوشمند آموزشی (Google Gemini API)
# نکته امنیتی: این کلید منحصراً در سرور استفاده می‌شود و هرگز به سمت کلاینت ارسال نمی‌گردد.
# ===================================================================
GEMINI_API_KEY="your-google-gemini-api-key-here"
AI_MODEL="gemini-1.5-flash"
AI_ENABLED=true
AI_TIMEOUT_SECONDS=7
